{
  "name": "h2map",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "spike:fetch": "tsx scripts/providers/fetch-all.ts",
    "spike:compare": "tsx scripts/providers/compare.ts",
    "parity:run": "tsx scripts/parity/run-parity.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "fast-check": "^4.1.1",
    "supabase": "^2.30.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
