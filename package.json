{
  "name": "h2map",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:scripts",
    "test:golden": "npm run test:golden -w @h2map/corridor-engine",
    "corridor:smoke": "tsx scripts/corridor/smoke-phase2.ts",
    "auth:smoke": "tsx scripts/corridor/smoke-auth.ts",
    "spike:fetch": "tsx scripts/providers/fetch-all.ts",
    "spike:compare": "tsx scripts/providers/compare.ts",
    "parity:run": "tsx scripts/parity/run-parity.ts",
    "parity:sensitivity": "tsx scripts/parity/sensitivity.ts",
    "hex:seed": "tsx scripts/hex/seed-hexes.ts",
    "hex:recompute": "tsx scripts/hex/recompute.ts",
    "hex:reseed-improved": "tsx scripts/hex/reseed-improved.ts",
    "hex:recover-solar": "tsx scripts/hex/recover-solar.ts",
    "defaults:ingest": "tsx scripts/defaults/ingest-defaults.ts",
    "defaults:profiles": "tsx scripts/defaults/apply-profiles.ts",
    "defaults:snapshot": "tsx scripts/defaults/snapshot-country-defaults.ts",
    "rankdiff": "tsx scripts/rankdiff/rankdiff.ts",
    "rankdiff:airdensity": "tsx scripts/rankdiff/measure-airdensity.ts",
    "rankdiff:turbineclass": "tsx scripts/rankdiff/measure-turbineclass.ts",
    "rankdiff:pvseam": "tsx scripts/rankdiff/measure-pvseam.ts",
    "rankdiff:wacc": "tsx scripts/rankdiff/measure-wacc.ts",
    "rankdiff:oversize": "tsx scripts/rankdiff/measure-oversize.ts",
    "rankdiff:costyear": "tsx scripts/rankdiff/measure-costyear.ts",
    "e2e": "playwright test",
    "corridor:docs": "tsx scripts/corridor/gen-docs.ts",
    "cells:export": "tsx scripts/rankdiff/export-cells.ts",
    "cells:check-cf": "tsx scripts/rankdiff/check-solar-cf.ts",
    "rankdiff:fixed-ratio": "tsx scripts/rankdiff/measure-fixed-ratio-penalty.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24",
    "eslint": "^9",
    "fast-check": "^4.1.1",
    "supabase": "^2.30.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  }
}
