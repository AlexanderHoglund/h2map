# Supabase — values from your project's dashboard (Settings → API) after
# following docs/SUPABASE_SETUP.md. Copy to apps/web/.env.local for dev.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-sb_publishable-key>

# Server-only (Route Handlers that write to the profile cache in Phase 2).
# NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=<service-role-or-sb_secret-key>
